{
  "name": "@sone/web",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b ../core ../client ../editor && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b ../core ../client ../editor && tsc -p tsconfig.json --noEmit",
    "test": "tsc -b ../core ../client ../editor && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@sone/client": "workspace:*",
    "@sone/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yjs": "13.6.32",
    "@sone/editor": "workspace:*",
    "prosemirror-view": "1.42.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "tsx": "^4.19.0"
  }
}
