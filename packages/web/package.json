{
  "name": "@sone/web",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b ../core ../client ../editor && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b ../core ../client ../editor && tsc -p tsconfig.json --noEmit",
    "test": "tsc -b ../core ../client ../editor && tsx --test \"test/*.test.ts\" \"test/*.test.tsx\""
  },
  "dependencies": {
    "@sone/client": "workspace:*",
    "@sone/core": "workspace:*",
    "@sone/editor": "workspace:*",
    "lucide-react": "^1.37.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
