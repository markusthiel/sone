{
  "name": "@sone/server",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -b ../core && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -b ../core && SONE_PASSWORD_COST=12 tsx --test test/*.test.ts",
    "migrate": "tsx scripts/migrate.mjs",
    "rematerialize": "tsx scripts/rematerialize.mjs",
    "test:db": "SONE_PASSWORD_COST=12 tsx --test test/*.db.test.ts"
  },
  "dependencies": {
    "@sone/core": "workspace:*",
    "pg": "^8.13.0",
    "yjs": "13.6.32",
    "ws": "^8.18.0",
    "lib0": "0.2.117",
    "y-protocols": "1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/ws": "^8.5.13"
  }
}
