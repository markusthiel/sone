{
  "name": "sone",
  "private": true,
  "version": "0.14.10",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:migrate": "node packages/server/scripts/migrate.mjs",
    "db:rematerialize": "node packages/server/scripts/rematerialize.mjs",
    "check": "node scripts/check-migrations.mjs && node scripts/check-rights-enforced.mjs && node scripts/check-env-numbers.mjs && node scripts/check-page-links.mjs && node scripts/check-workspace-deps.mjs && node scripts/check-single-crdt.mjs && pnpm -r typecheck && pnpm lint"
  },
  "pnpm": {
    "overrides": {
      "yjs": "13.6.32",
      "y-protocols": "1.0.7",
      "lib0": "0.2.117",
      "y-prosemirror": "1.3.7"
    },
    "patchedDependencies": {
      "y-prosemirror@1.3.7": "patches/y-prosemirror@1.3.7.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.68.0"
  }
}
