# SONE configuration. Copy to .env and edit the two required values.

# --- Required -----------------------------------------------------------

# Signing key for sessions and share tokens. Generate with:
#   openssl rand -base64 48
# Changing this invalidates all sessions and share links.
SONE_SECRET_KEY=

# Postgres password. Only used between the two containers.
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Recommended --------------------------------------------------------

# Public base URL. Share links are generated against this, so it must be the
# address users actually reach — not localhost, once behind a proxy.
SONE_PUBLIC_URL=http://localhost:3000

# Host port.
SONE_PORT=3000

# open   — anyone can register
# invite — registration only via invitation (default)
# closed — no new accounts; admin creates them
SONE_SIGNUP_MODE=invite

# --- Optional -----------------------------------------------------------

SONE_LOG_LEVEL=info
SONE_MAX_UPLOAD_MB=100

# local — files on the mounted volume (default, nothing else to run)
# s3    — any S3-compatible endpoint
SONE_STORAGE_BACKEND=local

# Only when SONE_STORAGE_BACKEND=s3
# SONE_S3_ENDPOINT=
# SONE_S3_REGION=
# SONE_S3_BUCKET=
# SONE_S3_ACCESS_KEY_ID=
# SONE_S3_SECRET_ACCESS_KEY=
# SONE_S3_FORCE_PATH_STYLE=true

# SMTP, for notification emails (ADR-0058).
#
# Without it no mail is attempted and nothing is offered in the interface: an
# instance without a relay is a normal instance. Invitations have never been
# emailed — that line stood here from the first commit describing something
# that did not exist, and an invitation link is still copied out of the
# administration area by hand.
#
# The host, port, user and sender can also be set in the administration area,
# which is where an operator will look; the password cannot, because a secret in
# a table is a secret in every backup.
# SONE_SMTP_HOST=
# SONE_SMTP_PORT=587
# SONE_SMTP_USER=
# SONE_SMTP_PASSWORD=
# SONE_SMTP_FROM=sone@example.org

# Reading replies to notifications (ADR-0060).
#
# With a mailbox configured, a notification carries a Reply-To carrying a signed
# token, and answering the mail posts a comment. Without one, no Reply-To is sent
# and nothing is polled — the feature is absent, not broken.
#
# The password is env-only, like the SMTP one: a secret in a table is a secret in
# every backup. Everything else can be set in the administration area.
# SONE_IMAP_HOST=
# SONE_IMAP_PORT=993
# SONE_IMAP_USER=
# SONE_IMAP_PASSWORD=
# The address people will reply to. Sub-addressing (sone+token@…) makes one
# address per notification, so one mailbox serves them all.
# SONE_REPLY_MAILBOX=sone@example.org

# Single sign-on (ADR-0024). Everything else about the provider is configured in
# the administration area; this one value is env-only, for the same reason as
# the SMTP password.
# SONE_OIDC_CLIENT_SECRET=

# How long a deleted workspace can be restored (ADR-0027).
# SONE_WORKSPACE_RETENTION_DAYS=30

# How much a password hash costs, as the exponent of N (ADR-0010).
#
# 16 is the default and the recommendation. Lower is faster and weaker: the
# server warns at startup and shows it in the maintenance panel, and raising it
# again upgrades existing passwords on their owners' next sign-in. The test
# suite sets 12; a running instance should not.
# SONE_PASSWORD_COST=16

# Permit starting against a database recorded as having run a newer version.
#
# An escape hatch, not a setting. The version fence compares strings, so a
# misleading version label can block a start that is actually fine — a
# development build following a release candidate, for instance. Set this for
# one start, then remove it. Logs a warning every time.
#
# Does not bypass the document-format check, which is about whether the code can
# read the data rather than about a label.
# SONE_ALLOW_DOWNGRADE=false
